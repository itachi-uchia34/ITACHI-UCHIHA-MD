# ============================================================================
# ITACHI UCHIHA MD - ENVIRONMENT CONFIGURATION
# ============================================================================

# Bot Settings
NAME=ITACHI UCHIHA MD
PREFIX=.
MODE=public

# Owner Settings
TELEGRAM_ID=5659752731
# Optional comma-separated Telegram IDs that should see owner commands in the bot menu
TELEGRAM_OWNER_IDS=5659752731
OWNER_NUMBER=923110470403
OWNER_JID=923110470403@s.whatsapp.net
# Railway: set this to the mounted persistent volume path.
SESSION_DIR=/app/session

# Anti-abuse safety defaults. These reduce spam-like behavior but cannot override WhatsApp enforcement.
ANTI_ABUSE_ENABLED=true
ANTI_ABUSE_MIN_DELAY_MS=450
ANTI_ABUSE_REACTION_DELAY_MS=180
ANTI_ABUSE_WINDOW_MS=60000
ANTI_ABUSE_MAX_MESSAGES=80
ANTI_ABUSE_MAX_BROADCAST=25
ANTI_ABUSE_DUPLICATE_WINDOW_MS=15000
ANTI_ABUSE_PAUSE_MS=60000

WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbC1gR3J3jv22YgI511b

# ============================================================================
# TELEGRAM DEPLOYMENT NOTIFICATIONS (Optional)
# ============================================================================
# Use this to run the Telegram bot and receive Telegram commands/notifications.
# Railway must keep this service running; the bot uses long polling.

# Enable/Disable Telegram Notifications
TELEGRAM_NOTIFY_ENABLED=true

# Your Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=8898084140:AAHw2SgZm4PbFVVAaBtmAJuLhOwQKayP_ho

# Your Telegram Chat ID (where to send notifications)
# For personal chat: Your Telegram user ID
# For group: Group chat ID (usually negative number)
# For channel: Channel ID (usually negative number)
TELEGRAM_CHAT_ID=-1003878963392

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 
# 1. Get Telegram Bot Token:
#    - Open Telegram and search for @BotFather
#    - Use /start and follow instructions
#    - Use /newbot to create a new bot
#    - Copy the token and paste above
#
# 2. Get Your Chat ID:
#    - Start a chat with your bot
#    - Send any message to your bot
#    - Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    - Look for "chat": { "id": XXXXXX }
#    - Copy the ID (XXXXXX) above
#
# 3. For Groups/Channels:
#    - Add bot to group/channel
#    - Send a message
#    - Use /getUpdates as above to find the group/channel ID
#    - It will be negative like -1001234567890
#
# ============================================================================

# Optional: Netscape-format YouTube cookies file for yt-dlp when YouTube blocks server requests
YTDLP_COOKIES_FILE=
